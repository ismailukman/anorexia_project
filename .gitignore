# Only the analysis code is tracked. Data, results and figures stay local.
/*
!/.gitignore
!/README.md
!/code/
!/data/
!/figures/

/code/*
!/code/python/
!/code/matlab/

/code/python/*
!/code/python/paths.py
!/code/python/atlas_groups.py
!/code/python/mlcd_measures.py
!/code/python/00b_edge_density.py
!/code/python/01c_combined_fc.py
!/code/python/01e_subcortical_network_assignment.py
!/code/python/05b_dfc_group_statistics.py
!/code/python/14_individual_vs_group.py
!/code/python/17_apriori_region_test.py
!/code/python/18_censoring_sensitivity.py
!/code/python/19_label_matching_rasters.py
!/code/python/09_abstract_figures.py
!/code/python/09b_fig1_panels.py

/code/matlab/*
!/code/matlab/combined_mlcd_full44_d05_par.m
!/code/matlab/multilayer_community_detection_individual.m
!/code/matlab/gridsearch_multilayer_modularity.m

/figures/*
!/figures/fig1_pipeline.png
!/figures/fig2_dynamic_fc.png
!/figures/fig3_significant_regions.png

# data/ keeps its folder layout only
/data/**
!/data/**/
!/data/**/.gitkeep

.DS_Store
__pycache__/
